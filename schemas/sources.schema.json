{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "config/sources.yml",
  "type": "object",
  "required": ["meta", "collectors"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["department", "institution"],
      "additionalProperties": false,
      "properties": {
        "department": {"type": "string"},
        "institution": {"type": "string"},
        "institution_ror": {"type": "string", "format": "uri"},
        "contact": {"type": "string"}
      }
    },
    "rsd": {"type": "object", "required": ["base", "organisation_id"]},
    "infrastructure": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "contribution", "content_authorship"],
        "properties": {
          "id": {"$ref": "common.defs.json#/$defs/slug"},
          "name": {"type": "string"},
          "url": {"type": "string"},
          "sparql": {"type": "string"},
          "webservice": {"type": "string"},
          "enabled": {"type": "boolean"},
          "contribution": {"type": "string", "minLength": 20,
                           "description": "What TGX actually does for this resource."},
          "content_authorship": {"type": "string", "minLength": 20,
                                 "description": "Who authors the content. Required so a figure can never imply the department wrote it."}
        }
      }
    },
    "collectors": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["enabled", "cadence_days"],
        "additionalProperties": false,
        "properties": {
          "enabled": {"type": "boolean"},
          "cadence_days": {"type": "integer", "minimum": 1, "maximum": 365}
        }
      }
    }
  }
}
